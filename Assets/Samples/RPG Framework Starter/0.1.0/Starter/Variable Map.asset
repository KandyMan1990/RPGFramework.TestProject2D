    m_Bank: 0
    m_Width: 2
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 28
    m_Description: 'Where a script left the field''s screen: clear, faded out, or a colour taken from it or added. Its default, 0, is clear'
