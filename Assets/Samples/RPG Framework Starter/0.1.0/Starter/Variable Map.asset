    m_Width: 9
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 12
    m_Description: The player's sound effects' volume, 0 to 1. Its default is a first launch's
    m_DefaultValue: 1065353216
