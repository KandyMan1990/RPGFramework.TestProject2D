    m_Bank: 0
    m_Width: 9
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 24
    m_Description: Which way the player faced when the game was saved, in degrees around the field's up axis. Its default is not used
    m_DefaultValue: 0
