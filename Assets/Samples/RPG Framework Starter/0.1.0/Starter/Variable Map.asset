    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Id: 17
    m_Name: LocationName
    m_Bank: 0
    m_Width: 8
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 48
    m_Description: The place the player is in, as the hash of its localisation key. Written by the module the player is in
    m_DefaultValue: 0
