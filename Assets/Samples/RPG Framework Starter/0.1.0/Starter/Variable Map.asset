  - m_Id: 15
    m_Name: SaveEnabled
    m_Bank: 1
    m_Width: 0
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 13
    m_Description: 'Whether the player can save from the party menu. Its default is the game''s policy: false to save only where a script allows it, true to save anywhere'
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Id: 16
