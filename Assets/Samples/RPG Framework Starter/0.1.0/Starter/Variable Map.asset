    m_Bank: 0
    m_Width: 4
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 30
    m_Description: The flags every random battle is fought with, and whether losing a battle or a countdown running out ends the game. Its default is a new game's
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Id: 13
