    m_Width: 5
    m_Count: 1
    m_Fields: []
    m_LastFieldId: 0
    m_Offset: 8
    m_Description: The spawn point the player arrives at in the game-over field. Only its default is used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Id: 9
