  m_Dimension: 1
  m_Entities:
  - m_EntityId: 0
    m_Name: Player0
    m_Body: {fileID: 9047889087783160858}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'SET_PLAYER_ENTITY

        VISIBILITY true

        RETURN'
      m_Slot: 0
  - m_EntityId: 1
    m_Name: UseCaseMusicPlayed1
    m_Body: {fileID: 5812890942467216488}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        RETURN'
      m_Slot: 0
  - m_EntityId: 2
    m_Name: UseCaseMusicState2
    m_Body: {fileID: 7730168096882632453}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        WAIT_SECONDS 0.5

        MUSIC_STEM_STATE UseCaseSong Both 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 3
    m_Name: UseCaseMusicStopped3
    m_Body: {fileID: 7111770444961654252}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        IS_MUSIC_PLAYING $UseCaseMusicPlaying

        WAIT_SECONDS 1

        STOP_MUSIC

        RETURN'
      m_Slot: 0
  - m_EntityId: 4
    m_Name: UseCaseMusicVolume4
    m_Body: {fileID: 3028114867910176522}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        SET_MUSIC_VOLUME 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 5
    m_Name: UseCaseMusicFaded5
    m_Body: {fileID: 2003658302929535366}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        FADE_MUSIC_VOLUME 0.25 1

        WAIT_FOR_MUSIC_VOLUME

        ADD_MONEY 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 6
    m_Name: UseCaseMusicFadedFrom6
    m_Body: {fileID: 1844377687265540628}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        FADE_MUSIC_VOLUME_FROM 0 0.75 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 7
    m_Name: UseCaseCrossfade7
    m_Body: {fileID: 2872523333262301552}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

