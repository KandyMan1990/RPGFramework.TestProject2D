    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'SET_PLAYER_ENTITY

        VISIBILITY true

        RETURN'
      m_Slot: 0
  - m_EntityId: 1
    m_Name: UseCaseFootsteps1
    m_Body: {fileID: 7443061044092315760}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'VISIBILITY true

        SET_INTERACTION_RANGE 2.5

        SET_BASE_ANIMATION Walk

        RETURN'
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'SET_FOOTSTEP_SOUND UseCaseSound false

        SET_FOOTSTEPS_ENABLED true false

        MOVE_ENTITY_AND_WAIT -12.5 13.5 0

        ADD_MONEY 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 2
    m_Name: UseCaseFootstepsOff2
    m_Body: {fileID: 627376953042971394}
    m_Scripts:
